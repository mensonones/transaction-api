{
  "name": "Transaction API — Local",
  "_postman_variable_scope": "environment",
  "values": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "default",
      "enabled": true
    },
    {
      "key": "accountId",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Set after running 'Create Account' (copy account_id from response)"
    },
    {
      "key": "documentNumber",
      "value": "12345678900",
      "type": "default",
      "enabled": true,
      "description": "Change between runs to avoid 409 on Create Account"
    },
    {
      "key": "idemKey",
      "value": "retry-key-001",
      "type": "default",
      "enabled": true,
      "description": "Used by the Retry pair in Idempotency folder. Change between runs."
    },
    {
      "key": "conflictKey",
      "value": "conflict-key-001",
      "type": "default",
      "enabled": true,
      "description": "Used by the Conflict pair in Idempotency folder. Change between runs."
    },
    {
      "key": "reusableKey",
      "value": "reusable-key-001",
      "type": "default",
      "enabled": true,
      "description": "Used by the Key Free After Error pair. Change between runs."
    }
  ]
}
